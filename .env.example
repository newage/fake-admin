# Docker Compose / MySQL (локальна розробка)
HTTP_PORT=8080
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=fake_admin
MYSQL_USER=fake_admin
MYSQL_PASSWORD=fake_admin

# OAuth: RSA-ключі (PEM у base64, один рядок) і ключ шифрування refresh.
# Заповнюються командою docker/scripts/gen-keys.sh
OAUTH_PRIVATE_KEY_B64=
OAUTH_PUBLIC_KEY_B64=
OAUTH_ENCRYPTION_KEY=

# Суперадмін: пароль встановлюється першим входом із цим email
SUPERADMIN_EMAIL=admin@example.com
